# Deployer / keeper key. Never commit the real .env.
PRIVATE_KEY=

# Robinhood Chain mainnet RPC. The public endpoint is rate limited;
# use an Alchemy URL for deploys, fork tests and the keeper.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Filled in after deploy; used by CreateSeason.s.sol and the keeper.
GAME_ADDRESS=
